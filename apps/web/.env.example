# apps/web/.env.example — copier en .env.local (jamais commité)
# Valeurs locales : affichées par `pnpm db:start` (API URL et Publishable / anon key)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=a-remplacer
# dev | preprod | prod — affiche un bandeau hors production
VITE_ENV=dev
VITE_DELAI_ANTI_REBOND_MS=3000
VITE_DUREE_RESULTAT_MS=1500
